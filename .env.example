# Copie para .env e ajuste. Variáveis de ambiente do sistema têm prioridade.

# --- Servidor / Web Terminal ---
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
# Gerado automaticamente na primeira execução se ficar vazio. Quem tiver o token controla o sistema.
JARVIS_TOKEN=

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
JARVIS_MODEL=jarvis
FRIDAY_MODEL=friday
VISION_MODEL=qwen2.5vl:7b
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT=600
FRIDAY_ENABLED=1
# smart = conversa simples sai direto (⚡ FAST); código/CAD/cálculos/BOM sempre auditados · always = tudo
FRIDAY_MODE=smart

# --- Kill Switch ---
KILL_HOTKEY=f1
KILL_HOTKEY_ENABLED=1
KILL_OLLAMA=1
# 1 = apenas registra o que seria encerrado (para testes)
JARVIS_KILL_DRY_RUN=0

# --- Voz ---
VOICE_ENABLED=1
WAKEWORD_MODEL=hey_jarvis
# 0.35 tolera sotaque PT-BR; suba para 0.5 se disparar sozinho, baixe para 0.25 se não reconhecer
WAKEWORD_THRESHOLD=0.35
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_LANGUAGE=pt
PIPER_VOICE=voices/pt_BR-faber-medium.onnx
# Opcional: usar o binário piper.exe em vez do pacote Python
PIPER_EXE=

# --- Google Sheets (BOM) ---
GOOGLE_CREDENTIALS=credentials/service_account.json
BOM_SPREADSHEET_ID=
BOM_SPREADSHEET_NAME=JARVIS - BOM
GOOGLE_SHARE_EMAIL=

# --- WhatsApp ---
WHATSAPP_WAIT=20
WHATSAPP_DEFAULT_COUNTRY=55

# --- Fusion 360 / Open Interpreter ---
# FUSION_SCRIPTS_DIR=C:\Users\SEU_USUARIO\AppData\Roaming\Autodesk\Autodesk Fusion 360\API\Scripts
# Python onde o open-interpreter está instalado (ex.: venv Python 3.11)
OI_PYTHON=
